# ---- LLM (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey — keep it server-side only, never in the frontend.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL_REASONING=gemini-2.5-pro
MODEL_FAST=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# ---- GitHub (read public repos; a token raises rate limits) ----
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ---- Database (Supabase Postgres + pgvector) ----
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---- Redis (queue, cache, cost counters) ----
REDIS_URL=redis://localhost:6379/0

# ---- App config ----
CORS_ORIGINS=http://localhost:3000
# Hard ceiling per analysis session, in USD. Guardrail against runaway agent cost.
SESSION_COST_CAP_USD=1.00
# Max files indexed per repo (keeps demo ingest bounded).
MAX_FILES_PER_REPO=400
